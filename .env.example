# Copy to .env.local and fill in. Both values are server-side only.

# Base URL of the Supabase project (no /functions/v1 suffix).
SUPABASE_URL="https://<project-ref>.supabase.co"

# Shared secret that authenticates this site to the Supabase Edge Functions.
# Must match the HOPPER_PROXY_SECRET set on the Supabase side.
HOPPER_PROXY_SECRET=""
